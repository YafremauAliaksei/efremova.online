{
  "name": "efremova-online",
  "version": "0.1.0",
  "private": true,
  "description": "Платформа частного психолога: публичный сайт + защищённый кабинет клиента",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "lint": "node scripts/run-eslint.mjs . --max-warnings=0",
    "lint:fix": "node scripts/run-eslint.mjs . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "security:audit": "node scripts/check-audit.mjs --omit-dev",
    "security:secrets": "gitleaks detect --no-git -v",
    "security:headers": "node scripts/check-security-headers.mjs",
    "security:headers:local": "node scripts/check-headers-local.mjs",
    "lighthouse": "lhci autorun",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "env:init": "node scripts/bootstrap-env.mjs",
    "dev:db": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis",
    "dev:db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "hooks:install": "git config core.hooksPath .githooks && node -e \"console.log('Хуки git установлены: проверка секретов перед каждым коммитом')\"",
    "setup": "npm run env:init && npm run dev:db && npm run db:migrate && npm run db:seed && npm run hooks:install",
    "stack:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build postgres redis app",
    "stack:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "stack:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f app",
    "ci": "node scripts/ci-local.mjs",
    "ci:quick": "node scripts/ci-local.mjs --quick",
    "admin:link": "node scripts/admin-link.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^15.1.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-security": "^3.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
