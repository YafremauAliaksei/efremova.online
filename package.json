{
  "name": "efremova-online",
  "version": "0.1.0",
  "private": true,
  "description": "Платформа частного психолога: публичный сайт + защищённый кабинет клиента",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "security:audit": "node scripts/check-audit.mjs --omit-dev",
    "security:secrets": "gitleaks detect --no-git -v",
    "security:headers": "node scripts/check-security-headers.mjs",
    "lighthouse": "lhci autorun",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "env:init": "node scripts/bootstrap-env.mjs",
    "dev:db": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis",
    "dev:db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "hooks:install": "git config core.hooksPath .githooks && node -e \"console.log('Хуки git установлены: проверка секретов перед каждым коммитом')\"",
    "setup": "npm run env:init && npm run dev:db && npm run db:migrate && npm run db:seed && npm run hooks:install"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.3.0",
    "bullmq": "^5.34.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^15.1.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-security": "^3.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
