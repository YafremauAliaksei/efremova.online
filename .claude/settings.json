{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git push *)",
      "Bash(git remote add:*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url:*)",
      "Bash(git remote set-url *)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-repo *)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-branch *)",
      "Bash(gh repo create:*)",
      "Bash(gh repo create *)",
      "Bash(gh secret:*)",
      "Bash(gh secret *)",
      "Bash(gh auth token:*)",
      "Bash(gh auth token *)",
      "Bash(npm publish:*)",
      "Bash(npm publish *)",
      "Bash(npm publish)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./infra/terraform/terraform.tfvars)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.sql)",
      "Read(./**/*.dump)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git commit)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(gh:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(docker compose down:*)",
      "Edit(./.claude/settings.json)",
      "Edit(./CLAUDE.md)",
      "Edit(./.github/workflows/**)",
      "Edit(./.githooks/**)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git check-ignore:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run format:*)",
      "Bash(npm run build:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run db:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run security:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(node scripts/check-security-headers.mjs:*)",
      "Bash(node scripts/check-staged-secrets.mjs:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Read",
      "Grep",
      "Glob"
    ]
  }
}
