{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.github/workflows/**)",
      "Edit(./.githooks/**)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Bash(git credential:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth refresh:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(npm publish:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh auth token:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./infra/terraform/terraform.tfvars)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.dump)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
