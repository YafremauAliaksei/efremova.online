// ═══════════════════════════════════════════════════════════════════════════
//  Схема базы данных — код, соответствующий диаграмме docs/02-database-erd.md
//
//  Договорённости, нарушать которые нельзя:
//    • Время   — всегда UTC (DateTime @db.Timestamptz)
//    • Деньги  — всегда целые, в минорных единицах (центы/копейки)
//    • Bytes   — поле зашифровано AES-256-GCM, ключ хранится ВНЕ базы
//    • *Hash   — необратимый отпечаток, оригинал не восстановить
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  // pgcrypto — шифрование на стороне базы, citext — регистронезависимые строки.
  // Расширения PostgreSQL пока за флагом предварительной функциональности.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ─────────────────────────── ПОЛЬЗОВАТЕЛИ И ДОСТУП ───────────────────────────

enum UserRole {
  CLIENT
  THERAPIST
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Хеш email — по нему ищем пользователя при входе, не расшифровывая таблицу
  emailHash      String  @unique
  /// Сам email в зашифрованном виде: утечка базы не должна давать список клиентов психолога
  emailEncrypted Bytes
  emailIv        Bytes
  phoneHash      String? @unique
  telegramIdEnc  Bytes?

  role   UserRole   @default(CLIENT)
  status UserStatus @default(ACTIVE)

  locale   String @default("ru")
  timezone String @default("Europe/Warsaw")

  /// Для THERAPIST и ADMIN всегда true — один аккаунт даёт доступ ко всем клиентам
  mfaRequired Boolean @default(false)

  keyVersion String @default("v1")

  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  lastLoginAt DateTime? @db.Timestamptz
  /// Мягкое удаление: GDPR-анонимизация, финансовые записи при этом сохраняются
  deletedAt   DateTime? @db.Timestamptz

  oauthAccounts    OAuthAccount[]
  otpChallenges    OtpChallenge[]
  sessions         AuthSession[]
  consents         Consent[]
  clientProfile    ClientProfile?
  therapistProfile TherapistProfile?
  auditLogs        AuditLog[]
  securityEvents   SecurityEvent[]
  dsrRequests      DataSubjectRequest[]
  notifications    Notification[]
  sessionNotes     SessionNote[]        @relation("NoteAuthor")
  approvedRefunds  Refund[]             @relation("RefundApprover")

  @@index([status, createdAt])
  @@map("users")
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String

  accessTokenEnc  Bytes?
  refreshTokenEnc Bytes?
  tokenIv         Bytes?
  expiresAt       DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum OtpChannel {
  TELEGRAM
  WHATSAPP
}

model OtpChallenge {
  id      String     @id @default(uuid()) @db.Uuid
  userId  String?    @db.Uuid
  channel OtpChannel

  destinationHash String
  /// Код хранится только как argon2id-хеш: даже мы не можем его прочитать
  codeHash        String
  /// Три попытки — потом код сгорает. Защита от перебора 6 цифр.
  attempts        Int    @default(0)
  maxAttempts     Int    @default(3)

  requestIp String?   @db.Inet
  expiresAt DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destinationHash, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model AuthSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  deviceFingerprintHash String?
  ip                    String? @db.Inet
  userAgent             String?
  geoCountry            String?

  createdAt     DateTime  @default(now()) @db.Timestamptz
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz
  revokedAt     DateTime? @db.Timestamptz
  revokedReason String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid

  tokenHash  String  @unique
  /// Цепочка ротации: каждый refresh одноразовый и порождает следующий
  replacedBy String? @db.Uuid
  /// Повторное использование уже потраченного токена = признак кражи.
  /// Реакция: убить всю цепочку сессий и поднять алерт.
  used       Boolean @default(false)

  expiresAt DateTime  @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum ConsentType {
  TOS
  PRIVACY
  HEALTH_DATA
  MARKETING
  COOKIES
}

/// Юридическое доказательство согласия (GDPR ст. 7): что, когда, с какого IP,
/// и какую именно версию документа человек видел в тот момент.
model Consent {
  id     String      @id @default(uuid()) @db.Uuid
  userId String      @db.Uuid
  type   ConsentType

  documentVersion String
  granted         Boolean
  ip              String? @db.Inet
  userAgent       String?

  grantedAt DateTime  @default(now()) @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consents")
}

// ─────────────────────────────── ПРОФИЛИ ───────────────────────────────

model ClientProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  displayNameEnc      Bytes
  displayNameIv       Bytes
  emergencyContactEnc Bytes?
  /// Анкета первичного приёма — чувствительнее всего, шифруется целиком
  intakeFormEnc       Bytes?
  birthDateEnc        Bytes?
  keyVersion          String @default("v1")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  payments     Payment[]

  @@map("client_profiles")
}

model TherapistProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  publicSlug String @unique
  bioMd      String @default("")
  /// Дипломы, сертификаты, членство в ассоциациях — важно для E-E-A-T (docs/04 п.4)
  credentials Json  @default("{}")

  defaultSessionMinutes Int    @default(50)
  bufferMinutes         Int    @default(10)
  cancelWindowHours     Int    @default(24)
  calendarId            String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments          Appointment[]
  availabilityRules     AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  calendarSyncState     CalendarSyncState?

  @@map("therapist_profiles")
}

// ────────────────────────────── РАСПИСАНИЕ ──────────────────────────────

enum SyncStatus {
  OK
  DEGRADED
  FAILED
}

model CalendarSyncState {
  id          String @id @default(uuid()) @db.Uuid
  therapistId String @unique @db.Uuid

  /// Токен инкрементальной синхронизации Google: забираем только изменения
  syncToken        String?
  channelId        String?
  channelExpiresAt DateTime? @db.Timestamptz
  lastFullSyncAt   DateTime? @db.Timestamptz
  status           SyncStatus @default(OK)
  lastError        String?

  therapist TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@map("calendar_sync_state")
}

/// Регулярное правило: «по вторникам с 10:00 до 18:00».
/// Время локальное + таймзона: при переводе часов правило не «уезжает».
model AvailabilityRule {
  id          String @id @default(uuid()) @db.Uuid
  therapistId String @db.Uuid

  weekday        Int
  startTimeLocal String
  endTimeLocal   String
  timezone       String    @default("Europe/Warsaw")
  validFrom      DateTime? @db.Date
  validTo        DateTime? @db.Date

  therapist TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, weekday])
  @@map("availability_rules")
}

enum ExceptionKind {
  BLOCKED
  EXTRA_SLOT
}

/// Разовое исключение: отпуск, больничный, дополнительный слот
model AvailabilityException {
  id          String @id @default(uuid()) @db.Uuid
  therapistId String @db.Uuid

  startsAt DateTime      @db.Timestamptz
  endsAt   DateTime      @db.Timestamptz
  kind     ExceptionKind
  reason   String?

  therapist TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, startsAt])
  @@map("availability_exceptions")
}

// ─────────────────────────── УСЛУГИ И ЦЕНЫ ───────────────────────────

model Service {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique

  /// { "pl": "...", "en": "...", "ru": "..." }
  titleI18n       Json
  descriptionI18n Json @default("{}")

  durationMinutes Int
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz

  prices       ServicePrice[]
  appointments Appointment[]

  @@map("services")
}

/// Цена зависит от региона клиента (docs/01: гео-определение валюты).
/// amountMinor — ЦЕЛОЕ число в центах/копейках: дробные числа дают
/// расхождения с бухгалтерией на больших объёмах.
model ServicePrice {
  id        String @id @default(uuid()) @db.Uuid
  serviceId String @db.Uuid

  region      String
  currency    String
  amountMinor Int

  validFrom DateTime  @default(now()) @db.Timestamptz
  validTo   DateTime? @db.Timestamptz

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, region, currency, validFrom])
  @@index([region, currency])
  @@map("service_prices")
}

// ─────────────────────────────── СЕССИИ ───────────────────────────────

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED_CLIENT
  CANCELLED_THERAPIST
  NO_SHOW
}

model Appointment {
  id          String @id @default(uuid()) @db.Uuid
  clientId    String @db.Uuid
  therapistId String @db.Uuid
  serviceId   String @db.Uuid

  startsAt DateTime          @db.Timestamptz
  endsAt   DateTime          @db.Timestamptz
  status   AppointmentStatus @default(PENDING_PAYMENT)

  googleEventId String?
  /// Защита от двойного клика «Забронировать»: UNIQUE-ограничение на уровне базы,
  /// а не проверка в коде — база не ошибается даже при одновременных запросах
  idempotencyKey String @unique

  cancelledAt     DateTime? @db.Timestamptz
  cancelReasonEnc Bytes?
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  client       ClientProfile    @relation(fields: [clientId], references: [id])
  therapist    TherapistProfile @relation(fields: [therapistId], references: [id])
  service      Service          @relation(fields: [serviceId], references: [id])
  videoMeeting VideoMeeting?
  note         SessionNote?
  payments     Payment[]

  // Главный индекс проекта: поиск свободных слотов — самый частый запрос
  @@index([therapistId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
  @@map("appointments")
}

enum VideoProvider {
  ZOOM
  GOOGLE_MEET
  TELEMOST
  VK_CALLS
  JITSI
}

/// Ссылка на созвон = фактический доступ к сеансу, поэтому шифруется
model VideoMeeting {
  id            String @id @default(uuid()) @db.Uuid
  appointmentId String @unique @db.Uuid

  provider          VideoProvider
  externalMeetingId String?
  joinUrlEnc        Bytes
  hostUrlEnc        Bytes?
  passcodeEnc       Bytes?
  iv                Bytes
  keyVersion        String        @default("v1")

  createdAt DateTime  @default(now()) @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("video_meetings")
}

/// Самые чувствительные данные в проекте. Ключ шифрования лежит вне базы,
/// каждое чтение фиксируется в AuditLog (требование ISO 27001 / врачебная тайна).
model SessionNote {
  id            String @id @default(uuid()) @db.Uuid
  appointmentId String @unique @db.Uuid
  authorId      String @db.Uuid

  contentCiphertext Bytes
  contentIv         Bytes
  keyVersion        String  @default("v1")
  /// По умолчанию заметка видна только психологу
  clientVisible     Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author      User        @relation("NoteAuthor", fields: [authorId], references: [id])

  @@map("session_notes")
}

// ─────────────────────────────── ПЛАТЕЖИ ───────────────────────────────

enum PaymentProviderKind {
  STRIPE
  PAYPAL
  YOOKASSA
  ROBOKASSA
  PRODAMUS
  CRYPTO_TRC20
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIAL_REFUND
}

model Payment {
  id            String  @id @default(uuid()) @db.Uuid
  appointmentId String? @db.Uuid
  clientId      String  @db.Uuid

  provider PaymentProviderKind
  status   PaymentStatus       @default(CREATED)

  amountMinor Int
  currency    String

  externalId     String?
  idempotencyKey String  @unique
  /// Сырой ответ провайдера. ⚠️ Карточные данные сюда не попадают никогда —
  /// они не проходят через наш сервер вообще (требование PCI DSS).
  providerPayload Json   @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  paidAt    DateTime? @db.Timestamptz

  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  client        ClientProfile  @relation(fields: [clientId], references: [id])
  events        PaymentEvent[]
  cryptoInvoice CryptoInvoice?
  refunds       Refund[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([provider, externalId])
  @@map("payments")
}

/// История смены статусов: полный аудит «кто и на основании чего изменил платёж».
/// Статус меняется ТОЛЬКО по webhook с проверенной подписью.
model PaymentEvent {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid

  fromStatus     PaymentStatus?
  toStatus       PaymentStatus
  source         String
  /// false = событие записано, но НЕ применено. Признак попытки подделки.
  signatureValid Boolean        @default(false)
  rawEvent       Json           @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

/// Крипто-оплата USDT TRC-20.
/// Адрес одноразовый и никогда не переиспользуется — иначе платежи разных
/// клиентов невозможно различить.
model CryptoInvoice {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @unique @db.Uuid

  network         String @default("TRON_TRC20")
  asset           String @default("USDT")
  address         String @unique
  /// Индекс в HD-кошельке. На сервере хранится только публичный xpub,
  /// приватные ключи — в холодном кошельке владельца.
  derivationIndex Int

  /// Сумма с «солью»: 50.00 → 50.0417. Делает платёж однозначно узнаваемым.
  expectedAmount String
  receivedAmount String?
  txHash         String?
  confirmations  Int     @default(0)
  requiredConfirmations Int @default(19)

  expiresAt DateTime  @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  settledAt DateTime? @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([expiresAt, settledAt])
  @@map("crypto_invoices")
}

enum RefundStatus {
  REQUESTED
  DONE
  FAILED
}

model Refund {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid

  amountMinor Int
  status      RefundStatus @default(REQUESTED)
  reason      String?
  approvedById String?     @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz
  completedAt DateTime? @db.Timestamptz

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("RefundApprover", fields: [approvedById], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ───────────────────────── КОНТЕНТ (ПУБЛИЧНАЯ ЧАСТЬ) ─────────────────────────

/// Одноразовая ссылка для входа в админку.
///
/// 🔑 ЗАЧЕМ ОТДЕЛЬНЫЙ МЕХАНИЗМ, ЕСЛИ ЕСТЬ OAUTH
///
/// 1. Пока Google и Telegram не подключены, войти в админку было бы нечем —
///    замкнутый круг: чтобы настроить сайт, нужно войти; чтобы войти,
///    нужен настроенный сайт.
/// 2. Даже после подключения это остаётся аварийным входом: внешний
///    провайдер может отказать в самый неподходящий момент.
///
/// Ссылка выписывается ТОЛЬКО из терминала сервера (npm run admin:link).
/// То есть для входа нужен доступ к серверу — это и есть подтверждение личности.
/// Сам токен в базе не хранится, только его хеш: утечка базы не даёт входа.
model AdminLoginToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique

  /// Кем выписан — для журнала. Обычно «cli».
  issuedBy  String   @default("cli")
  expiresAt DateTime @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  usedIp    String?  @db.Inet

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([expiresAt])
  @@map("admin_login_tokens")
}

/// Правовые документы: оферта, политика конфиденциальности, согласия.
///
/// ⚖️ ПОЧЕМУ ОТДЕЛЬНАЯ МОДЕЛЬ, А НЕ ОБЫЧНЫЙ БЛОК КОНТЕНТА
///
/// 1. Язык. Владелец ведёт деятельность в Польше, и по польскому праву
///    документы для потребителя должны быть доступны на польском языке.
///    Русская и английская версии — дополнительные.
/// 2. Версия. GDPR требует доказать, с какой именно редакцией документа
///    согласился человек. Поэтому версия хранится вместе с текстом,
///    а согласие ссылается на неё (см. Consent.documentVersion).
/// 3. Неизменность. Опубликованную редакцию нельзя править «на месте»:
///    создаётся новая, старая остаётся для тех, кто согласился с ней.
///
/// Текст хранится структурой (sections), а не разметкой HTML: так его
/// невозможно превратить в вектор XSS, и не нужен парсер Markdown.
model LegalDocument {
  id     String @id @default(uuid()) @db.Uuid
  /// privacy | terms | cookies
  slug   String
  /// pl | ru | en
  locale String
  /// Человекочитаемая версия, например privacy-2026-09-13. Попадает в Consent.
  version String

  title String
  /// [{ "heading": "...", "paragraphs": ["..."], "items": ["..."] }]
  sections Json    @default("[]")
  /// Черновик виден, но помечен как неутверждённый юристом
  isDraft  Boolean @default(true)
  /// Действующая редакция для этой пары slug+locale
  isCurrent Boolean @default(true)

  publishedAt DateTime @default(now()) @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@unique([slug, locale, version])
  @@index([slug, locale, isCurrent])
  @@map("legal_documents")
}

/// Согласие посетителя, который ещё не вошёл в кабинет (баннер cookie).
///
/// GDPR требует доказуемости согласия (ст. 7): что именно человек принял,
/// когда и какую редакцию документа видел. Анонимный идентификатор лежит
/// в cookie и не связан с личностью — это не трекинг, а квитанция.
model CookieConsent {
  id String @id @default(uuid()) @db.Uuid
  /// Случайный идентификатор из cookie. Персональных данных не содержит.
  visitorId String

  necessary   Boolean @default(true) // технические cookie — основание не согласие, а необходимость
  analytics   Boolean @default(false)
  marketing   Boolean @default(false)

  locale          String
  documentVersion String
  /// Хеш IP: доказательство обстоятельств согласия без хранения самого адреса
  ipHash    String?
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([visitorId, createdAt])
  @@map("cookie_consents")
}

/// Тексты сайта живут в базе, а НЕ в коде.
///
/// Зачем так (docs/06-public-repo-strategy.md):
///   • репозиторий можно держать публичным — в нём нет ни одного личного текста,
///     фотографии, цены или отзыва: только код и обезличенная демо-заготовка;
///   • владелец правит тексты через админку, без программиста и без деплоя;
///   • перевод на другой язык — это строка в базе, а не правка кода.
model ContentBlock {
  id     String @id @default(uuid()) @db.Uuid
  /// Смысловой ключ: hero.title, about.body, cta.button
  key    String
  locale String @default("ru")

  title String?
  body  String?
  /// Для блоков сложной формы: списки преимуществ, пункты подхода
  data  Json    @default("{}")

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([key, locale])
  @@index([locale, isPublished])
  @@map("content_blocks")
}

model LectureCategory {
  id        String @id @default(uuid()) @db.Uuid
  slug      String @unique
  titleI18n Json
  sortOrder Int    @default(0)

  lectures Lecture[]

  @@map("lecture_categories")
}

/// Кэш данных YouTube: ходить в API на каждый запрос нельзя —
/// там жёсткие квоты, и это убило бы скорость страницы
model Lecture {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid

  youtubeId       String  @unique
  title           String
  description     String  @default("")
  durationSeconds Int     @default(0)
  thumbnailUrl    String?
  viewCount       Int     @default(0)
  isVisible       Boolean @default(true)

  publishedAt DateTime? @db.Timestamptz
  syncedAt    DateTime  @default(now()) @db.Timestamptz

  category LectureCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId, publishedAt])
  @@map("lectures")
}

/// Только псевдоним автора: реальное имя клиента психолога — чувствительные данные
model Testimonial {
  id          String  @id @default(uuid()) @db.Uuid
  authorAlias String
  body        String
  rating      Int     @default(5)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("testimonials")
}

// ─────────────────────── АУДИТ И БЕЗОПАСНОСТЬ ───────────────────────

/// APPEND ONLY. Удаление и изменение строк запрещено триггером в базе.
/// prevHash/rowHash образуют цепочку: подмена записи в середине рвёт цепочку,
/// и ночная проверка это обнаруживает.
model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid

  action     String
  entityType String
  entityId   String?
  ip         String? @db.Inet
  userAgent  String?
  /// ⚠️ Сюда НИКОГДА не попадает содержимое медицинских записей —
  /// только факт доступа: кто, когда, к какой записи.
  metadata   Json    @default("{}")

  prevHash String?
  rowHash  String

  createdAt DateTime @default(now()) @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum SecurityEventKind {
  LOGIN_FAILED
  OTP_BRUTEFORCE
  HONEYPOT
  RATE_LIMIT
  CSRF_FAIL
  SSRF_BLOCK
  WEBHOOK_BAD_SIGNATURE
  TOKEN_REUSE
  ANOMALY
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecurityEvent {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid

  kind     SecurityEventKind
  severity Severity          @default(LOW)

  ip      String? @db.Inet
  country String?
  path    String?
  details Json    @default("{}")

  honeypotHitId String? @db.Uuid
  blocklistId   String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz

  user        User?         @relation(fields: [userId], references: [id])
  honeypotHit HoneypotHit?  @relation(fields: [honeypotHitId], references: [id])
  blocklist   IpBlocklist?  @relation(fields: [blocklistId], references: [id])

  @@index([ip, createdAt])
  @@index([kind, severity, createdAt])
  @@map("security_events")
}

enum TrapType {
  PATH
  FORM_FIELD
  ROBOTS_BAIT
  FAKE_API
  JS_BEACON
  TIMING
}

model HoneypotHit {
  id       String   @id @default(uuid()) @db.Uuid
  trapId   String
  trapType TrapType

  ip             String? @db.Inet
  country        String?
  userAgent      String?
  requestHeaders Json    @default("{}")
  /// Тело запроса обрезается до 4 КБ: этого хватает для анализа,
  /// а хранить больше — риск сохранить чужие вредоносные данные целиком
  requestBody    String?
  scoreDelta     Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz

  securityEvents SecurityEvent[]

  @@index([ip, createdAt])
  @@index([trapType, createdAt])
  @@map("honeypot_hits")
}

enum BlockAction {
  CHALLENGE
  BLOCK
}

/// Баны временные (по умолчанию 24 ч) — чтобы клиент за корпоративным NAT
/// не остался заблокированным навсегда из-за чужого сканера в той же сети
model IpBlocklist {
  id      String  @id @default(uuid()) @db.Uuid
  ip      String? @db.Inet
  network String? @db.VarChar(64)

  score  Int         @default(0)
  action BlockAction @default(CHALLENGE)
  reason String?
  /// Бан ставится в Cloudflare: трафик разворачивается в их датацентре
  /// и до нашего сервера не доходит вообще
  pushedToCloudflare Boolean @default(false)

  expiresAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  securityEvents SecurityEvent[]

  @@unique([ip])
  @@index([expiresAt])
  @@map("ip_blocklist")
}

// ───────────────────────── GDPR И УВЕДОМЛЕНИЯ ─────────────────────────

enum DsrKind {
  EXPORT
  DELETE
  RECTIFY
  RESTRICT
}

enum DsrStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

/// Запросы субъекта данных (GDPR ст. 15-20).
/// dueAt = createdAt + 30 дней — законный срок ответа.
model DataSubjectRequest {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @db.Uuid
  kind   DsrKind
  status DsrStatus @default(NEW)

  notes       String?
  dueAt       DateTime  @db.Timestamptz
  completedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@map("data_subject_requests")
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Notification {
  id     String              @id @default(uuid()) @db.Uuid
  userId String              @db.Uuid

  channel  NotificationChannel
  template String
  status   NotificationStatus  @default(QUEUED)
  /// ⚠️ Никакого медицинского содержимого. Только «у вас сессия завтра в 14:00».
  /// Письмо может прочитать кто угодно, имеющий доступ к почте клиента.
  payload  Json                @default("{}")

  scheduledAt DateTime  @db.Timestamptz
  sentAt      DateTime? @db.Timestamptz
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
