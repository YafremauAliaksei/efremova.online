// ═══════════════════════════════════════════════════════════════════════════
//  Схема базы данных публичного сайта efremova.online
//
//  ⚠️ ЗДЕСЬ ТОЛЬКО ТО, ЧТО РАБОТАЕТ ПРЯМО СЕЙЧАС.
//
//  Полная схема на 33 таблицы — пользователи, записи на приём, видеовстречи,
//  заметки психолога, платежи, возвраты, уведомления — описана в
//  истории git как проект личного кабинета. В коде её нет
//  намеренно: кабинет переезжает на отдельный поддомен и отдельный сервер,
//  а на основном домене не должно быть ни одной таблицы с личными данными
//  клиентов — даже пустой. Нет таблицы — нечему утечь.
//
//  История не потеряна: вырезанные таблицы остаются в истории git — см. ветку
//  chore/truth-pass (PR #33).
//
//  Договорённости, нарушать которые нельзя:
//    • Время   — всегда UTC (DateTime @db.Timestamptz)
//    • Деньги  — всегда целые, в минорных единицах (центы/копейки)
//    • *Hash   — необратимый отпечаток, оригинал не восстановить
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

// ⚠️ Здесь НЕТ строки url = env("DATABASE_URL").
//
// Prisma 7 убрала подключение к базе из схемы. Причин две, и обе полезные:
// схема описывает структуру данных, а не то, к какому серверу подключаться,
// и пароль от базы больше физически не может оказаться в файле, который
// лежит в публичном репозитории.
//
// Теперь адрес базы живёт в двух местах, у каждого своя задача:
//   • prisma.config.ts — для команд миграций (prisma migrate, prisma studio);
//   • src/lib/db.ts    — для самого приложения, через адаптер драйвера.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────── УСЛУГИ И ЦЕНЫ ───────────────────────────

model Service {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique

  /// { "pl": "...", "en": "...", "ru": "..." }
  titleI18n       Json
  descriptionI18n Json @default("{}")

  durationMinutes Int
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz

  prices ServicePrice[]

  @@map("services")
}

/// Цена зависит от региона клиента (валюта выбирается по стране или вручную).
/// amountMinor — ЦЕЛОЕ число в центах/копейках: дробные числа дают
/// расхождения с бухгалтерией на больших объёмах.
model ServicePrice {
  id        String @id @default(uuid()) @db.Uuid
  serviceId String @db.Uuid

  region      String
  currency    String
  amountMinor Int

  validFrom DateTime  @default(now()) @db.Timestamptz
  validTo   DateTime? @db.Timestamptz

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, region, currency, validFrom])
  @@index([region, currency])
  @@map("service_prices")
}

// ───────────────────────── КОНТЕНТ (ПУБЛИЧНАЯ ЧАСТЬ) ─────────────────────────

/// Одноразовая ссылка для входа в админку.
///
/// 🔑 ПОЧЕМУ ИМЕННО ТАК, А НЕ ЛОГИН С ПАРОЛЕМ
///
/// Пароль можно подобрать, украсть или выманить. Здесь подбирать нечего:
/// ссылка выписывается только тем, у кого есть доступ к терминалу сервера.
/// Внешние способы входа (Google, Telegram) на основном домене не
/// используются вовсе — ни одного обращения к чужим серверам.
///
/// Ссылка выписывается ТОЛЬКО из терминала сервера (npm run admin:link).
/// То есть для входа нужен доступ к серверу — это и есть подтверждение личности.
/// Сам токен в базе не хранится, только его хеш: утечка базы не даёт входа.
model AdminLoginToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique

  /// Кем выписан — для журнала. Обычно «cli».
  issuedBy  String    @default("cli")
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  usedIp    String?   @db.Inet

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([expiresAt])
  @@map("admin_login_tokens")
}

/// Правовые документы: политика конфиденциальности, условия, положения о сайте.
///
/// ⚖️ ПОЧЕМУ ОТДЕЛЬНАЯ МОДЕЛЬ, А НЕ ОБЫЧНЫЙ БЛОК КОНТЕНТА
///
/// 1. Язык. Владелец ведёт деятельность в Польше, и по польскому праву
///    документы для потребителя должны быть доступны на польском языке.
///    Русская и английская версии — дополнительные.
/// 2. Версия. Нужно уметь показать, какая редакция действовала в какой
///    момент: при споре важен текст, который человек видел тогда, а не сейчас.
/// 3. Неизменность. Опубликованную редакцию нельзя править «на месте»:
///    создаётся новая, старая остаётся в истории.
///
/// Текст хранится структурой (sections), а не разметкой HTML: так его
/// невозможно превратить в вектор XSS, и не нужен парсер Markdown.
model LegalDocument {
  id      String @id @default(uuid()) @db.Uuid
  /// privacy | terms | cookies
  slug    String
  /// pl | ru | en
  locale  String
  /// Человекочитаемая версия, например privacy-2026-09-13. Показывается под текстом.
  version String

  title     String
  /// [{ "heading": "...", "paragraphs": ["..."], "items": ["..."] }]
  sections  Json    @default("[]")
  /// Черновик виден, но помечен как неутверждённый юристом
  isDraft   Boolean @default(true)
  /// Действующая редакция для этой пары slug+locale
  isCurrent Boolean @default(true)

  publishedAt DateTime @default(now()) @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@unique([slug, locale, version])
  @@index([slug, locale, isCurrent])
  @@map("legal_documents")
}

/// Тексты сайта живут в базе, а НЕ в коде.
///
/// Зачем так (docs/06-public-repo-strategy.md):
///   • репозиторий можно держать публичным — в нём нет ни одного личного текста,
///     фотографии, цены или отзыва: только код и обезличенная демо-заготовка;
///   • владелец правит тексты через админку, без программиста и без деплоя;
///   • перевод на другой язык — это строка в базе, а не правка кода.
model ContentBlock {
  id     String @id @default(uuid()) @db.Uuid
  /// Смысловой ключ: hero.title, about.body, cta.button
  key    String
  locale String @default("ru")

  title String?
  body  String?
  /// Для блоков сложной формы: списки преимуществ, пункты подхода
  data  Json    @default("{}")

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([key, locale])
  @@index([locale, isPublished])
  @@map("content_blocks")
}

model LectureCategory {
  id        String @id @default(uuid()) @db.Uuid
  slug      String @unique
  titleI18n Json
  sortOrder Int    @default(0)

  lectures Lecture[]

  @@map("lecture_categories")
}

/// Кэш данных YouTube: ходить в API на каждый запрос нельзя —
/// там жёсткие квоты, и это убило бы скорость страницы
model Lecture {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid

  youtubeId       String  @unique
  title           String
  description     String  @default("")
  durationSeconds Int     @default(0)
  thumbnailUrl    String?
  viewCount       Int     @default(0)
  isVisible       Boolean @default(true)

  publishedAt DateTime? @db.Timestamptz
  syncedAt    DateTime  @default(now()) @db.Timestamptz

  category LectureCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId, publishedAt])
  @@map("lectures")
}

/// Только псевдоним автора: реальное имя клиента психолога — чувствительные данные
model Testimonial {
  id          String  @id @default(uuid()) @db.Uuid
  authorAlias String
  body        String
  rating      Int     @default(5)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("testimonials")
}

// ─────────────────────── АУДИТ И БЕЗОПАСНОСТЬ ───────────────────────

/// APPEND ONLY. Удаление и изменение строк запрещено триггером в базе.
/// prevHash/rowHash образуют цепочку: подмена записи в середине рвёт цепочку,
/// и ночная проверка это обнаруживает.
model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  /// Кто действовал. Действующее лицо пока одно — администратор,
  /// поэтому здесь свободная строка, а не связь с таблицей пользователей.
  actorId String?

  action     String
  entityType String
  entityId   String?
  ip         String? @db.Inet
  userAgent  String?
  /// ⚠️ Сюда НИКОГДА не попадает содержимое медицинских записей —
  /// только факт доступа: кто, когда, к какой записи.
  metadata   Json    @default("{}")

  prevHash String?
  rowHash  String

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum SecurityEventKind {
  LOGIN_FAILED
  OTP_BRUTEFORCE
  HONEYPOT
  RATE_LIMIT
  CSRF_FAIL
  SSRF_BLOCK
  WEBHOOK_BAD_SIGNATURE
  TOKEN_REUSE
  ANOMALY
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// События безопасности, склеенные так же, как попадания в ловушки,
/// и по той же причине (см. комментарий к HoneypotHit).
model SecurityEvent {
  id String @id @default(uuid()) @db.Uuid

  ipKey       String
  kind        SecurityEventKind
  bucketStart DateTime          @db.Timestamptz

  eventCount Int      @default(1)
  severity   Severity @default(LOW)

  // ─── Снимок первого события в этом часе ───
  ip      String? @db.Inet
  country String?
  path    String?
  details Json    @default("{}")

  honeypotHitId String? @db.Uuid
  blocklistId   String? @db.Uuid

  firstSeenAt DateTime @default(now()) @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @db.Timestamptz

  honeypotHit HoneypotHit? @relation(fields: [honeypotHitId], references: [id])
  blocklist   IpBlocklist? @relation(fields: [blocklistId], references: [id])

  @@unique([ipKey, kind, bucketStart])
  @@index([bucketStart])
  @@index([kind, severity, bucketStart])
  @@map("security_events")
}

enum TrapType {
  PATH
  FORM_FIELD
  ROBOTS_BAIT
  FAKE_API
  JS_BEACON
  TIMING
}

/// Попадания в ловушку, СКЛЕЕННЫЕ по связке «адрес + тип ловушки + час».
///
/// ── ПОЧЕМУ НЕ СТРОКА НА КАЖДОЕ ПОПАДАНИЕ ──────────────────────────────────
///
/// Объём записей задавал бы атакующий, а не мы. Сканер на 1000 запросов
/// в секунду за час создал бы 3,6 миллиона строк — и защита от атаки стала бы
/// способом забить диск. Классическая ошибка: механизм безопасности сам
/// оказывается уязвимым местом.
///
/// Здесь первое попадание в часе создаёт строку и сохраняет в ней СНИМОК
/// запроса: путь, заголовки, агент. Все последующие только увеличивают
/// счётчик. Миллион запросов = одна строка.
///
/// Побочная выгода важнее экономии места: **начало атаки не вытесняется
/// никогда**. Ротация логов по размеру теряет именно начало — самое ценное
/// при разборе. Здесь начало записано первым и не перезаписывается.
///
/// Подробно: docs/03-security-policy.md, п.4.
model HoneypotHit {
  id String @id @default(uuid()) @db.Uuid

  /// Ключ склейки: адрес или 'unknown'.
  ///
  /// ⚠️ Отдельное поле NOT NULL, а не ip, — намеренно. В PostgreSQL два NULL
  /// в уникальном индексе считаются разными значениями, поэтому склейка
  /// по неизвестному адресу молча перестала бы работать, и каждый запрос
  /// без адреса снова создавал бы свою строку.
  ipKey       String
  trapType    TrapType
  /// Начало часа в UTC — граница склейки
  bucketStart DateTime @db.Timestamptz

  /// Сколько раз за этот час. Растёт вместо создания новых строк.
  hitCount Int @default(1)

  // ─── Снимок ПЕРВОГО попадания в этом часе ───
  trapId         String
  /// Полный адрес. Основание — законный интерес (защита сервиса),
  /// срок хранения 60 дней, объявлен в политике конфиденциальности.
  ip             String? @db.Inet
  country        String?
  userAgent      String?
  path           String?
  requestHeaders Json    @default("{}")
  /// Тело запроса обрезается до 4 КБ: этого хватает для анализа,
  /// а хранить больше — риск сохранить чужие вредоносные данные целиком
  requestBody    String?
  scoreDelta     Int     @default(0)

  firstSeenAt DateTime @default(now()) @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @db.Timestamptz

  securityEvents SecurityEvent[]

  @@unique([ipKey, trapType, bucketStart])
  @@index([bucketStart])
  @@index([ipKey, bucketStart])
  @@map("honeypot_hits")
}

enum BlockAction {
  CHALLENGE
  BLOCK
}

/// Баны временные (по умолчанию 24 ч) — чтобы клиент за корпоративным NAT
/// не остался заблокированным навсегда из-за чужого сканера в той же сети
model IpBlocklist {
  id      String  @id @default(uuid()) @db.Uuid
  ip      String? @db.Inet
  network String? @db.VarChar(64)

  score              Int         @default(0)
  action             BlockAction @default(CHALLENGE)
  reason             String?
  /// Бан ставится в Cloudflare: трафик разворачивается в их датацентре
  /// и до нашего сервера не доходит вообще
  pushedToCloudflare Boolean     @default(false)

  expiresAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  securityEvents SecurityEvent[]

  @@unique([ip])
  @@index([expiresAt])
  @@map("ip_blocklist")
}

/// Инцидент — «чёрный ящик» массовой атаки.
///
/// ── ЗАЧЕМ ОТДЕЛЬНАЯ ЗАПИСЬ, ЕСЛИ ЕСТЬ СКЛЕЕННЫЕ ПОПАДАНИЯ ──────────────────
///
/// Склейка отвечает на вопрос «кто и сколько раз». Инцидент отвечает на другой:
/// «когда это началось и что творилось в тот момент». Он создаётся ОДИН РАЗ
/// при переходе порога, а не на каждое событие, поэтому его объём — килобайты
/// независимо от силы атаки. Атакующий не может заставить нас писать больше.
///
/// По открытию инцидента запрашивается внеплановый бэкап: ждать планового
/// в 03:00 нельзя, разбираться будет уже не с чем.
model SecurityIncident {
  id String @id @default(uuid()) @db.Uuid

  openedAt DateTime  @default(now()) @db.Timestamptz
  /// Закрывается, когда активность вернулась к норме
  closedAt DateTime? @db.Timestamptz

  /// Что сработало, например HONEYPOT_RATE
  trigger       String
  /// Сколько попаданий было в окне в момент перехода порога
  triggerCount  Int
  windowMinutes Int

  /// Снимок на момент открытия: первые уникальные сигнатуры.
  /// Объём ограничен кодом — см. src/lib/security/recorder.ts
  snapshot Json @default("{}")

  /// Накопленный итог за инцидент
  totalHits   Int @default(0)
  /// Сколько записей отброшено потолком. Честная отметка «мы видели не всё»:
  /// без неё счётчик молча занижал бы масштаб атаки.
  droppedHits Int @default(0)

  lastActivityAt DateTime @default(now()) @db.Timestamptz

  /// Когда по этому инциденту запросили внеплановый бэкап.
  /// Заполняется здесь, читается контейнером бэкапа (ветка ops/log-rotation).
  backupRequestedAt DateTime? @db.Timestamptz

  @@index([openedAt])
  @@index([closedAt, lastActivityAt])
  @@map("security_incidents")
}

// ───────────────────────── GDPR И УВЕДОМЛЕНИЯ ─────────────────────────
