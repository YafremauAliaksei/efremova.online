# Что НЕ отправляется в Docker при сборке образа.
#
# ЗАЧЕМ ЭТОТ ФАЙЛ
# Перед сборкой Docker копирует к себе весь каталог проекта («контекст»).
# Без этого файла туда попадает node_modules — около гигабайта, — и сборка
# из нескольких минут превращается в десятки. Зависимости внутри образа
# всё равно ставятся заново командой npm ci: так гарантируется, что версии
# соответствуют lock-файлу, а не тому, что случайно лежит на машине.
#
# Вторая причина важнее первой: без этого файла в образ может попасть .env
# с настоящими ключами. Образ — это файл, который уезжает на сервер
# и в реестр; секретам там не место.

# ─── Секреты. Первая строка не случайно ───
.env
.env.*
!.env.example
*.pem
*.key
secrets/
terraform.tfvars
*.tfstate
*.tfstate.*

# ─── Зависимости и артефакты сборки ───
node_modules
.next
out
build
dist
coverage
*.tsbuildinfo

# ─── Git и настройки инструментов разработки ───
.git
.gitignore
.githooks
.github
.claude
.vscode
.idea

# ─── То, что не нужно приложению в рантайме ───
docs
infra/terraform
infra/nginx
*.md
!README.md
.lighthouserc.json
.prettierrc.json
.prettierignore
eslint.config.mjs

# ─── Локальные данные и логи ───
postgres-data
redis-data
backups
*.log
*.sql
*.dump
