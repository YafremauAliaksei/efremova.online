# ═══════════════════════════════════════════════════════════════════════
#  ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
#
#  Как пользоваться:
#    1. Скопировать этот файл в .env       (cp .env.example .env)
#    2. Заполнить реальными значениями
#    3. .env НИКОГДА не коммитить в git — он уже в .gitignore
#
#  Как сгенерировать случайный секрет (32 байта):
#    openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════════

# ─── Базовое ───
NODE_ENV=development
APP_URL=https://efremova.online
APP_ENV=development                        # development | staging | production

# ─── База данных ───
DATABASE_URL=postgresql://app:CHANGE_ME@localhost:5432/efremova?schema=public&sslmode=prefer
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=efremova

# ─── Redis (сессии, OTP, очереди) ───
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_PASSWORD=CHANGE_ME

# ─── Авторизация ───
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_URL=https://efremova.online
JWT_ACCESS_TTL=900                         # 15 минут, в секундах
JWT_REFRESH_TTL=2592000                    # 30 дней

# OAuth 2.0 — Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 2.0 — Apple Developer → Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# OTP через Telegram — токен от @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
TELEGRAM_ADMIN_CHAT_ID=                    # куда слать алерты безопасности

# WhatsApp Business (опционально, позже)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── ШИФРОВАНИЕ МЕДИЦИНСКИХ ДАННЫХ ───
# ⚠️ КРИТИЧНО: потеря этого ключа = безвозвратная потеря всех заметок сессий.
# ⚠️ В проде хранить в Infisical / HashiCorp Vault / AWS KMS, а НЕ в .env на сервере.
# ⚠️ Ротация — раз в год, старый ключ сохраняется для чтения архива.
FIELD_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
FIELD_ENCRYPTION_KEY_VERSION=v1
FIELD_ENCRYPTION_KEY_V0=                   # предыдущий ключ, только для расшифровки архива

# ─── Google Calendar ───
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=CHANGE_ME

# ─── Видеосвязь (VideoCall Factory) ───
VIDEO_PROVIDER=google_meet                 # zoom | google_meet | telemost | vk_calls | jitsi
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
YANDEX_TELEMOST_OAUTH_TOKEN=
VK_CALLS_SERVICE_TOKEN=
JITSI_DOMAIN=
JITSI_JWT_APP_ID=
JITSI_JWT_SECRET=

# ─── Платежи ───
PAYMENT_PROVIDERS_ENABLED=stripe           # через запятую: stripe,yookassa,crypto_trc20
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
PRODAMUS_SECRET_KEY=

# Crypto USDT TRC-20
CRYPTO_ENABLED=false
TRON_XPUB=                                 # ТОЛЬКО публичный ключ. Приватный на сервере НЕ хранить
TRON_NETWORK=mainnet
TRONGRID_API_KEY=
CRYPTO_REQUIRED_CONFIRMATIONS=19
CRYPTO_INVOICE_TTL_MINUTES=30

# ─── Уведомления ───
RESEND_API_KEY=
EMAIL_FROM=noreply@efremova.online

# ─── Безопасность и мониторинг ───
CLOUDFLARE_API_TOKEN=                      # права: Zone.Firewall Services (Edit)
CLOUDFLARE_ZONE_ID=
HONEYPOT_ENABLED=true
HONEYPOT_BAN_THRESHOLD=100                 # баллов до блокировки
HONEYPOT_CHALLENGE_THRESHOLD=50            # баллов до CAPTCHA
PENTEST_BYPASS_TOKEN=                      # отключает ловушки для легального пентеста
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── YouTube (медиа-хаб) ───
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_SYNC_INTERVAL_HOURS=6

# ─── Гео и валюты ───
DEFAULT_CURRENCY=EUR
CURRENCY_MAP=PL:PLN,RU:RUB,BY:RUB,DEFAULT:EUR
