# ═══════════════════════════════════════════════════════════════════════
#  ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
#
#  Как пользоваться:
#    1. npm run setup — создаст .env со случайными локальными секретами сам
#    2. Либо вручную: cp .env.example .env и заполнить значения
#    3. .env НИКОГДА не коммитить в git — он уже в .gitignore
#
#  Как сгенерировать случайный секрет (32 байта):
#    openssl rand -base64 32
#
#  ── ПОЧЕМУ ЗДЕСЬ ТАК МАЛО СТРОК ───────────────────────────────────────
#
#  Раньше в этом файле было больше шестидесяти переменных: OAuth, Stripe,
#  ЮKassa, крипто-кошельки, Zoom, Телемост, YouTube API, Sentry, Resend.
#  Ни одна из них не читалась ни строчкой кода — это был список планов,
#  выданный за конфигурацию.
#
#  Основной домен efremova.online — сайт-визитка. Он не обращается
#  ни к одному внешнему сервису: ни скриптов, ни шрифтов, ни API.
#  Всё перечисленное вернётся вместе с личным кабинетом, который поедет
#  на отдельный поддомен и в отдельное окружение
#  (docs/13-site-architecture.md).
# ═══════════════════════════════════════════════════════════════════════

# ─── Базовое ───
NODE_ENV=development
# Канонический адрес сайта: на нём строятся canonical, sitemap и переброски
# из middleware. Сервер за nginx своего домена не знает — без APP_URL
# посетителя уносило бы на http://localhost:3000
APP_URL=https://efremova.online
APP_ENV=development                        # development | staging | production

# ─── Туннель Cloudflare (только на сервере) ───
# Токен из панели Cloudflare: Zero Trust → Networks → Tunnels (docs/15).
# Это ключ входа сайта в интернет: только здесь, права на .env — 600
CLOUDFLARE_TUNNEL_TOKEN=

# ─── База данных ───
DATABASE_URL=postgresql://app:CHANGE_ME@localhost:5432/efremova?schema=public&sslmode=prefer
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=efremova

# ─── Подпись сессии администратора ───
# Без него админка не работает; сам сайт работает.
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# ─── Второй фактор входа в админку ───
# Секрет приложения-аутентификатора: npm run admin:2fa выпускает его и
# показывает, как добавить в приложение. Пусто — вход по одной ссылке,
# и сайт нельзя перевести в рабочий режим.
ADMIN_TOTP_SECRET=

# ─── Ловушки для сканеров ───
HONEYPOT_ENABLED=true                      # 'false' выключает — только для отладки
PENTEST_BYPASS_TOKEN=                      # отключает ловушки для легального пентеста

# ─── Бэкапы (только на сервере, docs/17) ───
# ПУБЛИЧНЫЙ ключ age (age1…): сервер шифрует, расшифровать не может.
# Приватный ключ — только у владельца, зашифрованный паролем, не здесь
BACKUP_AGE_PUBLIC_KEY=
# Копия у другого поставщика (Cloudflare R2 / Backblaze B2). Пусто — копия
# только на этом сервере, бэкап предупредит об этом в журнале
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=                        # R2: https://<id-аккаунта>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto                      # R2 — auto; B2 — регион бакета
BACKUP_S3_ACCESS_KEY_ID=                   # ключ с правом записи ТОЛЬКО в этот бакет
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_HEARTBEAT_URL=                      # Healthchecks: отдельная проверка «бэкап», период 1 день

# ─── Сторож сервера: оповещения о сбоях (docs/16) ───
# Задан канал — сообщения идут в него; можно несколько сразу. Ни одного —
# сбои видно только в журнале контейнера watchdog.
WATCHDOG_NAME=ноутбук                      # подпись в сообщениях: какой сервер
# Telegram: бот от @BotFather, свой id — у @userinfobot; боту один раз /start
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# ntfy (приложение-уведомления): https://ntfy.sh/<длинное-случайное-имя>
ALERT_NTFY_URL=
# Почта через Resend: адрес отправителя — на домене, подтверждённом в Resend
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_RESEND_API_KEY=
# Пульс в Healthchecks.io: если сервер умер целиком, напишет уже Healthchecks
ALERT_HEARTBEAT_URL=
# Пороги (необязательно): диск и память в %, нагрузка на ядро, медленный ответ в мс
WATCHDOG_DISK_PERCENT=85
WATCHDOG_MEMORY_PERCENT=90
WATCHDOG_LOAD_PER_CPU=2
WATCHDOG_SLOW_MS=5000
WATCHDOG_SUMMARY_HOUR_UTC=7                # час ежедневной сводки, UTC
