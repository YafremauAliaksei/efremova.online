{
  "ci": {
    "collect": {
      "startServerCommand": "npm start",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3000/ru",
        "http://localhost:3000/ru/services",
        "http://localhost:3000/pl/about"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }],
        "speed-index": ["error", { "maxNumericValue": 2000 }],

        "total-byte-weight": ["error", { "maxNumericValue": 400000 }],
        "unused-javascript": ["warn", { "maxNumericValue": 20000 }],
        "modern-image-formats": ["error", { "maxNumericValue": 0 }],
        "uses-responsive-images": ["error", { "maxNumericValue": 0 }],
        "font-display": "error",
        "color-contrast": "error",
        "image-alt": "error",
        "html-has-lang": "error",
        "meta-description": "error",
        "csp-xss": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
